         // Measured trip overhead: with the plain c * tau trip cost (ef1) the b6 bags halved (median about 15) and collection
         // fell 12% by r600 (316 vs 358), while fh2's bags (about 32) lost more on death; tributed by r1000 434 (fh2) vs 411
         // (ef1). A trip also breaks the farming flow (claims, respawn timing), so it costs about 3 x c x tau: bags near 26.
-        const double batch = std::sqrt(2.0 * 3.0 * c * c * tau / (m * h + lambda * c / 5.0));
+        // Cap at 60: on rich cluster maps the batch grows with the collection rate (adgato_gemcombat5: about 227 at r71, so
+        // the 140-gem capturer waited 60 rounds for the respawn and walked 280 gems to the altar alone); banked at once,
+        // the bag leaves while its teammates are still beside it and can escort it (below). bq2's cap of 40 also bound on
+        // interlock and corridors bags and cost tributes there.
+        const double batch = std::min(60.0, std::sqrt(2.0 * 3.0 * c * c * tau / (m * h + lambda * c / 5.0)));
         if ((gems >= batch && S.round >= bank_blocked_until && !S.holding) || endgame) {
             // Give up for a while if the way to the altar makes no progress (blocked or contested).
             // Waiting at a hole edge for the dash is not a blocked way (dh1).
@@ -714,6 +718,46 @@
             return;
         }
     }
+    // Escort a big bag: a teammate within 8 with 60+ gems and no group claimed (on its way to an altar, or home) gets a
+    // healthy light-bagged companion until it tributes. adgato_gemcombat5 (sq2 on bwmp, to r1000): when a carrier of 30+
+    // gems met an enemy within 10 of the one altar, the rivals had a teammate within 6 in 6.15 of 9.1 contacts per game and
+    // lost 0.65 bags; ours had one in 3.7 of 9.7 and lost 1.40 (297 gems lost on death per game against 102).
+    {
+        const bool capturing = current_target >= 0 && W.groups[current_target].state == 1 && W.groups[current_target].tiles.is_set(p);
+        const ChampSnap* carrier = nullptr;
+        int carrier_bag = 0;
+        if (gems < 30 && S.hp >= S.max_hp * 0.5f && !capturing && !S.holding && me.can_move())
+            for (const auto& a : S.allies) {
+                if (dist(p, a.pos) > 8) continue;
+                // Ally snapshots carry no bag (knowledge.h reads gems for enemies only): read it here, for the few in
+                // reach. esc1 and esc2 tested a.gems and never escorted.
+                int bag = 0;
+                try {
+                    cambc::champion ch = a.ch;
+                    bag = static_cast<int>(ch.gem_count());
+                } catch (const cambc::error&) {
+                    continue;
+                }
+                if (bag < 60) continue;
+                // A carrier on a group's tiles is capturing or boxed in at a respawning group: escorts walking up to it
+                // fill its way out (esc3: the 140-gem capturer froze with its escorts in the pocket's exit).
+                bool on_group = false;
+                for (const auto& gr : W.groups) if (gr.tiles.is_set(a.pos)) { on_group = true; break; }
+                if (on_group) continue;
+                int s = -1;
+                for (int k = 0; k < MAX_SLOTS && k < static_cast<int>(W.slot_ids.size()); ++k)
+                    if (W.slot_ids[k] == handle_id(a.ch)) s = k;
+                if (s < 0 || claim_cache[s] != -1) continue;
+                if (!carrier || bag > carrier_bag) carrier = &a, carrier_bag = bag;
+            }
+        if (carrier) {
+            ACT("escort");
+            write_claim(-1);
+            if (gems > 0 && W.altar_field.get(p) <= 1 && bank_gems()) return;
+            if (dist(p, carrier->pos) > 1) walk_towards(carrier->pos);
+            return;
+        }
+    }
     STAGE("pick");
     // Keep fighting an awake target; one champion captures; the rest follow the team target.
     const bool in_fight = current_target >= 0 && W.groups[current_target].state == 0
