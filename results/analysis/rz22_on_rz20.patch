-        if (static_cast<int>(t.chebyshev_distance(src)) <= radius) return true;
+    float sum = 0;
+    for (const auto& d : S.danger)
+        if (static_cast<int>(t.chebyshev_distance(d.pos)) <= d.radius && (sum += d.burst) >= S.danger_bar) return true;
     return false;
 }
+// Each set of enemies whose bursts sum to the bar threatens the tiles all of them reach: the squares of their reaches
+// (Chebyshev) meet in one rectangle when every two of them meet. A set that holds a smaller such set adds no tile, so
+// only the minimal sets are kept (once per turn, after the snapshot): masks count up, so every subset of a set comes
+// before it. rz21 built a board for every set on each call and ran out of fuel after round 3 58 times in 48 local games
+// (main 6).
+void find_danger_sets() {
+    S.danger_sets.clear();
+    const size_t n = S.danger.size();
+    std::array<unsigned, 8> meet{};
+    for (size_t i = 0; i < n; ++i)
+        for (size_t j = 0; j < n; ++j)
+            if (static_cast<int>(S.danger[i].pos.chebyshev_distance(S.danger[j].pos)) <= S.danger[i].radius + S.danger[j].radius)
+                meet[i] |= 1u << j;
+    for (unsigned m = 1; m < (1u << n); ++m) {
+        bool keep = true;
+        for (const unsigned k : S.danger_sets)
+            if ((k & m) == k) keep = false;
+        float sum = 0;
+        for (size_t i = 0; i < n && keep; ++i)
+            if (m >> i & 1u) {
+                keep = (m & ~meet[i]) == 0;
+                sum += S.danger[i].burst;
+            }
+        if (keep && sum >= S.danger_bar) S.danger_sets.push_back(m);
+    }
+}
 // The danger tiles as one board, for routing around them.
 bitboard danger_tiles() {
     bitboard b;
     b.clear();
-    for (const auto& [src, radius] : S.danger) b.draw_chebyshev(src, static_cast<float>(radius));
+    static std::array<bitboard, 8> reach;
+    static bitboard x;
+    unsigned drawn = 0;
+    for (const unsigned m : S.danger_sets) {
+        int first = -1;
+        for (size_t i = 0; i < S.danger.size(); ++i) {
+            if (!(m >> i & 1u)) continue;
+            if (!(drawn >> i & 1u)) {
+                reach[i].clear();
+                reach[i].draw_chebyshev(S.danger[i].pos, static_cast<float>(S.danger[i].radius));
+                drawn |= 1u << i;
+            }
+            if (first < 0) {
+                first = static_cast<int>(i);
+                if (m == 1u << i) break;
+                x.clear();
+                x |= reach[i];
+            } else {
+                x &= reach[i];
+            }
+        }
+        b |= m == 1u << first ? reach[first] : x;
+    }
     return b;
 }
 
