+// A ranged champion 4 or 5 tiles from an enemy: dash to the least exposed landing within basic range, then shoot. The
+// rivals' Vespers dash and then shoot 7.85 times per game (sq2 on brkp2, to r1000; ours 0.16), 1.58 of them on our
+// non-fighting champions; in the top 12 games the top teams do it 7.55 times per game. Only onto a landing where the
+// enemies' burst is under half our health.
+bool dash_shot(const ChampSnap& target) {
+    if (stale() || S.range < 3) return false;
+    const int d = dist(S.me, target.pos);
+    if (d <= S.range || d > S.range + 2) return false;
+    auto& me = cambc::self();
+    if (!me.can_attack() || !me.can_cast()) return false;
+    for (const auto& ab : me.abilities()) {
+        if (!ab.is_dash() || !castable_now(ab)) continue;
+        vec2 best{-1, -1};
+        float best_e = 0;
+        for (auto t : dash_landings(ab).positions()) {
+            if (S.occ.is_set(t) || W.terrain.is_set(t) || dist(t, target.pos) > S.range) continue;
+            const float e = exposure_at(t);
+            if (best.x < 0 || e < best_e) best = t, best_e = e;
+        }
+        if (best.x < 0 || best_e >= S.hp * 0.5f || stale()) return false;
+        try {
+            if (ab.use(best)) {
+                moved_to(best);
+                return attack_unit(target.ch);
+            }
+            S.occ.set(best);
+        } catch (const cambc::error&) {
+            S.occ.set(best);
+        }
+        return false;
+    }
+    return false;
+}
+
