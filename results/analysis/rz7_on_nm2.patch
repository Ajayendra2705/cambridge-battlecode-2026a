+// Melee with a dash closing from 4 tiles in one turn: a step onto a tile 3 from the target from which a dash lands next
+// to it, then the dash (Heart of Ruin's striking dash lands its damage and stun there), leaving the basic attack for the
+// caller. The rivals' Hearts and Vendettas open fights this way 2.4 times per game on brkp2 and the top 12 teams' about
+// 4.9, ours never (`tools/replay/fs_closein.py`). Only when the landing is exposed to less than half our health.
+bool step_dash_next_to(const ChampSnap& target) {
+    if (stale() || S.walked) return false;
+    auto& me = cambc::self();
+    if (!me.can_move() || !me.can_cast() || !me.can_attack() || dist(S.me, target.pos) != 4) return false;
+    int range = 0;
+    for (const auto& ab : me.abilities()) {
+        if (!ab.is_dash() || !castable_now(ab)) continue;
+        range = 2;
+        if (ab.info())
+            if (const auto* d = std::get_if<cambc::ability_dash>(&*ab.info())) range = std::max(1, static_cast<int>(d->range));
+        break;
+    }
+    if (range < 2) return false;
+    refresh_occ();
+    const bitboard path_block = cm::walls() | cm::altars() | W.enemy_spawn | S.occ;
+    vec2 best{-1, -1};
+    float best_e = 0;
+    for (auto d : DIRS) {
+        const vec2 w{S.me.x + d.x, S.me.y + d.y};
+        if (!cm::is_in_bounds(w) || W.terrain.is_set(w) || S.occ.is_set(w) || dist(w, target.pos) != 3) continue;
+        bitboard land = path_block.reachable_tiles(w, static_cast<std::uint16_t>(range)) & ~W.terrain & ~S.occ;
+        land.set(w, false);
+        bool ok = false;
+        float e = 0;
+        for (auto t : land.positions()) {
+            if (dist(t, target.pos) > S.range) continue;
+            const float x = exposure_at(t);
+            if (!ok || x < e) e = x, ok = true;
+        }
+        if (ok && (best.x < 0 || e < best_e)) best = w, best_e = e;
+    }
+    if (best.x < 0 || best_e >= S.hp * 0.5f || stale()) return false;
+    if (!safe_move(best)) return false;
+    return strike_dash({target.pos}, false) || dash_next_to(target);
+}
