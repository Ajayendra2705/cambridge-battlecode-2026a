+// Enemy champions within 3 of a tile minus ours there (this champion and the allies within 3).
+int margin_at(vec2 t) {
+    int m = -1;
+    for (const auto& e : S.enemies) if (dist(t, e.pos) <= 3) ++m;
+    for (const auto& a : S.allies) if (dist(t, a.pos) <= 3) --m;
+    return m;
+}
+// Walk next to an enemy only where they do not outnumber us within 3, or one short against a target under 40% health.
+// Our Vendetta and Varg walked in one or more short 2.40 times per game (the rivals' 1.33): one short against a target
+// above 40% they died within 10 rounds after 0.28 (theirs 0.08) and the target after 0.08; two or more short 0.54
+// (0.20); one short against a hurt target 0.07, with the target dead after 0.36. Our Vesper walked in short 0.45 times
+// per game and died after 0.47 (theirs 0.21, 0.17). Heart of Ruin and Marcella die after it no more than the rivals' do
+// (0.28 and 0.16 deaths per game against 0.30 and 0.18). rz9 on b13p2, b16p, b17p; `tools/replay/walkins.py`.
+bool walk_in_refused(vec2 t, const ChampSnap& target) {
+    const auto ty = cambc::self().champion_name();
+    if (ty == cambc::champion_type::heart_of_ruin || ty == cambc::champion_type::marcella) return false;
+    bool next_to = false;
+    for (const auto& e : S.enemies) if (!W.enemy_spawn.is_set(e.pos) && dist(t, e.pos) <= 1) next_to = true;
+    return next_to && margin_at(t) > (target.hp <= 0.4f * target.max_hp ? 1 : 0);
+}
