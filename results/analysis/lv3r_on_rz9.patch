+// Harmless groups on our side: clusters only (no camp hits back), at least 3 steps nearer our spawn than theirs.
+std::vector<signed char> static_own_clusters;
+bool own_clusters(int gi) {
+    if (static_own_clusters.empty()) static_own_clusters.assign(W.groups.size(), -1);
+    if (static_own_clusters[gi] < 0) {
+        float full = 0;
+        for (float s : W.groups[gi].strength) full += s;
+        static_own_clusters[gi] = W.group_side[gi] <= -3 && full <= 0.0f ? 1 : 0;
+    }
+    return static_own_clusters[gi] == 1;
+}
