+// A ranged champion one tile beyond its basic range: walk in, cast the attack reset (it restores the shot the walk cost),
+// shoot. Probe rz5p: 63 of 63 such tries landed. sq2 on brkp2 (to r1000): the rivals' shooters hit our champions outside
+// fights 2.63 times per game after a walk and a reset (1.58 more after a dash), ours none; in the top 12 games the top
+// teams do it 4.6 times per game, their opponents 3.4. Only onto a tile where the enemies' burst is under half our health.
+bool step_reset_shot(const ChampSnap& target) {
+    if (stale() || S.range < 3 || dist(S.me, target.pos) != S.range + 1) return false;
+    auto& me = cambc::self();
+    if (!me.can_move() || !me.can_attack() || !me.can_cast()) return false;
+    bool ready = false;
+    for (const auto& ab : me.abilities()) if (ab.is_attack_reset() && ab.is_ready()) ready = true;
+    if (!ready) return false;
+    vec2 best{-1, -1};
+    float best_e = 0;
+    for (auto d : DIRS) {
+        const vec2 t{S.me.x + d.x, S.me.y + d.y};
+        if (!cm::is_in_bounds(t) || W.terrain.is_set(t) || S.occ.is_set(t) || dist(t, target.pos) > S.range) continue;
+        const float e = exposure_at(t);
+        if (best.x < 0 || e < best_e) best = t, best_e = e;
+    }
+    if (best.x < 0 || best_e >= S.hp * 0.5f || stale() || !safe_move(best)) return false;
+    for (const auto& ab : me.abilities()) {
+        if (!ab.is_attack_reset() || !ab.is_ready()) continue;
+        if (stale()) return false;
+        try {
+            if (ab.use() && attack_unit(target.ch)) {
+                ++n_reset;
+                return true;
+            }
+        } catch (const cambc::error&) {
+        }
+        break;
+    }
+    return false;
+}
