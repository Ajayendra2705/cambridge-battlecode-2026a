+// Middle strong groups (an elk or stronger, side -6..6) on teams of four or more, with another live one within 12 tiles:
+// the team takes them one at a time and wakes each only with four of us there (camp_fight.h). On 00ribs (brk, cw1) our
+// arrivals woke the two elks one at a time and tanked them alone (60 a round each) while teammates farmed beside them:
+// three of ours recalled and two died by r100, and the enemy's five arrived at full health (docs/findings.md, "00ribs
+// opening, meetings and tank assist"). A lone middle strong group keeps the old play: waiting before the elk and the
+// golem of 00crater (22 tiles apart) let the enemy wake and take them, and our deaths doubled (local ce2).
+bool mid_strong(int gi) {
+    const auto& g = W.groups[gi];
+    return W.team_count >= 4 && W.group_side[gi] >= -6 && W.group_side[gi] <= 6 && g.hardest() >= 60.0f;
+}
+bool strong_pair(int i, int j) {
+    if (j == i || !mid_strong(j)) return false;
+    for (auto a : W.groups[i].spawns)
+        for (auto b : W.groups[j].spawns)
+            if (dist(a, b) <= 12) return true;
+    return false;
+}
+// By the map, whatever the partner's state: the respawns of 00ribs's two elks alternate, and a lone one waited for nobody
+// (local, live partners only: wakes with under three of us within 6 4.7 per game, 1.0 with any partner).
+bool paired_strong(int gi) {
+    if (!mid_strong(gi)) return false;
+    for (int j = 0; j < static_cast<int>(W.groups.size()); ++j)
+        if (strong_pair(gi, j)) return true;
+    return false;
+}
+// A map with such a pair (00ribs): its middle is held as a team (camp_fight.h, the hold before a held middle group).
+bool paired_map() {
+    static int v = -1;
+    if (v < 0) {
+        v = 0;
+        for (int i = 0; i < static_cast<int>(W.groups.size()) && !v; ++i) v = paired_strong(i);
+    }
+    return v == 1;
+}
+// Of the paired middle strong groups near an asleep one we picked, the team takes first one that is awake and claimed by
+// one of us, else the asleep one with the most claims (ours included; the lower index on a tie), so arrivals converge on
+// it. Only the final pick is redirected: skipping the others while scoring sent three of five to gold clusters near home
+// before the hill (local ce1: arrivals r45-77, main r45-57). A pick that waits at a respawning one goes to a live partner
+// instead, claimed or not: on brkp (ce3) the capturer of the first 00ribs elk stood alone beside its respawn (60 rounds)
+// while four of us fought the second, and the enemy's five took it first (619fd4aa, r80-98).
+int strong_lead(int i, int current) {
+    const bool waiting = W.groups[i].state == 2;
+    int lead = i, lead_claims = waiting ? -1 : claimants(i) + (current == i);
+    bool lead_awake = false;
+    for (int j = 0; j < static_cast<int>(W.groups.size()); ++j) {
+        const auto& h = W.groups[j];
+        if (h.state != 0 || !strong_pair(i, j)) continue;
+        const int claims = claimants(j) + (current == j);
+        if (claims == 0 && (!waiting || h.damaged())) continue;
+        if (h.damaged()) {
+            if (!lead_awake) lead = j, lead_awake = true;
+        } else if (!lead_awake && (claims > lead_claims || (claims == lead_claims && j < lead))) {
+            lead = j, lead_claims = claims;
+        }
+    }
+    return lead;
+}
