+// Steps (straight) to group i's spawns from the nearest teammate not heading there, or UNREACH.
+int free_mate_dist(int i) {
+    int best = UNREACH;
+    for (const auto& a : S.allies) {
+        const auto id = handle_id(a.ch);
+        int s = 0;
+        while (s < W.team_count && W.slot_ids[s] != id) ++s;
+        if (s >= W.team_count || s >= MAX_SLOTS || s == W.slot || claim_cache[s] == i) continue;
+        for (auto sp : W.groups[i].spawns) best = std::min(best, dist(a.pos, sp));
+    }
+    return best;
+}
+
+// A group with a golem (its hardest camp 100-149 strength) outside the enemy's half: cleared by a crew.
+bool golem_crew_group(int i) {
+    const float h = W.groups[i].hardest();
+    return W.group_side[i] <= 0 && h >= 100.0f && h < 150.0f;
+}
