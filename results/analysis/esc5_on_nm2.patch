@@ -69,6 +69,17 @@
 
 World W;
 
+// A map whose camp groups give no gold (the five adgato_gemcombat maps of 70): gold comes only from kills and Marcella's
+// tributes, and cluster groups of up to 140 gems lie far from one altar. Read after init_world has filled W.groups.
+bool cashless_map() {
+    static const bool v = [] {
+        int gold = 0;
+        for (const auto& g : W.groups) gold += g.gold;
+        return gold == 0;
+    }();
+    return v;
+}
