+// Probe pf20: fuel per turn and per stage in contact turns (an enemy champion within 6, off its spawn) and in quiet
+// turns, by champions within 8, and the stage that was running when a turn ran out of fuel. Printed every 250 rounds.
+namespace probe {
+struct StageAcc { const char* name = nullptr; std::uint64_t sum = 0, max = 0; int n = 0; };
+struct Acc {
+    int n = 0, spilled = 0, o60 = 0, o80 = 0;
+    std::uint64_t sum = 0, max = 0;
+    std::array<StageAcc, 24> st{}, spill_at{};
+    std::array<std::uint64_t, 4> crowd_sum{}, crowd_max{};
+    std::array<int, 4> crowd_n{};
+};
+Acc contact, quiet;
+StageAcc& slot(std::array<StageAcc, 24>& a, const char* name) {
+    for (auto& s : a) {
+        if (!s.name) { s.name = name; return s; }
+        if (!std::strcmp(s.name, name)) return s;
+    }
+    return a.back();
+}
+void account(int r0, std::uint64_t f0) {
+    if (!W.ready || S.round != r0) return;  // No snapshot this turn: dead, channelling or setup.
+    int crowd = 0;
+    bool hot = false;
+    for (const auto& e : S.enemies) {
+        if (W.enemy_spawn.is_set(e.pos)) continue;
+        const int d = dist(S.me, e.pos);
+        if (d <= 6) hot = true;
+        if (d <= 8) ++crowd;
+    }
+    for (const auto& a : S.allies) if (dist(S.me, a.pos) <= 8) ++crowd;
+    Acc& acc = hot ? contact : quiet;
+    ++acc.n;
+    if (static_cast<int>(cambc::round_number()) != r0) {
+        ++acc.spilled;
+        int last = 0;
+        for (int i = 0; i < prof_n; ++i) if (prof_round[i] == r0) last = i;
+        ++slot(acc.spill_at, prof_names[last]).n;
+        return;
+    }
+    const std::uint64_t used = f0 - cambc::fuel_remaining();
+    acc.sum += used;
+    acc.max = std::max(acc.max, used);
+    if (used > 60000) ++acc.o60;
+    if (used > 80000) ++acc.o80;
+    const int b = crowd <= 2 ? 0 : crowd <= 4 ? 1 : crowd <= 6 ? 2 : 3;
+    acc.crowd_sum[b] += used;
+    ++acc.crowd_n[b];
+    acc.crowd_max[b] = std::max(acc.crowd_max[b], used);
+    for (int i = 0; i + 1 < prof_n; ++i) {
+        const std::uint64_t c = prof_fuel[i] - prof_fuel[i + 1];
+        auto& s = slot(acc.st, prof_names[i]);
+        s.sum += c;
+        ++s.n;
+        s.max = std::max(s.max, c);
+    }
+}
+void print(int round) {
+    for (int k = 0; k < 2; ++k) {
+        const Acc& a = k ? quiet : contact;
+        const int full = a.n - a.spilled;
+        std::cout << "PF s" << W.slot << " r" << round << (k ? " quiet" : " contact") << " n=" << a.n << " spill=" << a.spilled
+                  << " mean=" << (full > 0 ? a.sum / full : 0) << " max=" << a.max << " o60=" << a.o60 << " o80=" << a.o80 << " crowd";
+        for (int b = 0; b < 4; ++b)
+            std::cout << " " << b << ":" << a.crowd_n[b] << "/" << (a.crowd_n[b] ? a.crowd_sum[b] / a.crowd_n[b] : 0) << "/" << a.crowd_max[b];
+        std::cout << " |";
+        for (const auto& s : a.st) if (s.name && s.n) std::cout << " " << s.name << "=" << s.sum / s.n << "/" << s.max << "/" << s.n;
+        std::cout << " | spill_at";
+        for (const auto& s : a.spill_at) if (s.name) std::cout << " " << s.name << "=" << s.n;
+        std::cout << '\n';
+    }
+}
