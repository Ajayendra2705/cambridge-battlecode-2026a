+
+// Audit build. Every caught engine error prints one "E" line when it happens (games end at any round, so totals
+// printed every 500 rounds missed the last part of each game), with whether the turn ran out of fuel and resumed
+// since its snapshot (split), whether this turn placed a ward, the stage and the activity.
+vec2 audit_start{-1, -1};  // Our tile when this turn's snapshot was taken.
+int audit_round = -1;      // Round of that snapshot this turn, -1 before it (turns that return before it are not audited).
+int audit_ward_round = -1; // Round of the snapshot of the turn that last placed a ward.
+int audit_turn_start = -1; // Round this turn began.
+int audit_print_round = -1;  // Round of the last audit_print (its prints can run the turn out of fuel).
+void audit_fail(const char* file, int line, const cambc::error& e) {
+    const int r = static_cast<int>(cambc::round_number());
+    std::cout << "E r" << r << " " << file << ":" << line << " split=" << (audit_round >= 0 && r != audit_round)
+              << " ward=" << (audit_round >= 0 && audit_ward_round == audit_round) << " stage=" << bot_stage << " act=" << activity
+              << " what=" << e.what() << '\n';
+}
+#define AUDIT(e) audit_fail(__FILE__, __LINE__, e)
+// Logic checks: (kind, activity that ended the turn) counters. Both are string literals, so pointers compare.
+struct AuditNote { const char* kind; const char* act; int n; };
+std::vector<AuditNote> audit_notes;
+void audit_note(const char* kind, const char* act) {
+    for (auto& s : audit_notes)
+        if (s.kind == kind && s.act == act) { ++s.n; return; }
+    audit_notes.push_back({kind, act, 1});
+}
+void audit_print() {
+    audit_print_round = static_cast<int>(cambc::round_number());
+    for (const auto& s : audit_notes) std::cout << "X r" << cambc::round_number() << " " << s.kind << "." << s.act << ":0 n=" << s.n << " -\n";
+}
+// Fuel: a turn that runs out resumes next round from the same point, so a stage that sees a new round ran on after
+// a suspension during the stage before it. Turns that printed the audit totals are left out.
+int audit_turn_round = -1;
+const char* audit_prev_stage = "start";
+void audit_stage(const char* name) {
+    const int r = static_cast<int>(cambc::round_number());
+    if (audit_turn_round >= 0 && r != audit_turn_round && audit_print_round != audit_turn_start)
+        audit_note(r < 30 ? "fuel_split_early" : "fuel_split_late", audit_prev_stage);
+    audit_turn_round = r;
+    audit_prev_stage = name;
+}
