+// Audit: what a turn left unused, by the activity that ended it. Only turns that took a snapshot count.
+void audit_end_turn() {
+    auto& me = cambc::self();
+    if (!W.ready || audit_round != static_cast<int>(cambc::round_number())) return;
+    try {
+        if (!me.is_alive() || me.is_recalling() || me.is_submitting_gems() || me.is_teleporting()) return;
+        const vec2 at = me.position();
+        const bool moved = at != audit_start;
+        bool champ_in_range = false, camp_in_range = false, champ_in_4 = false;
+        int nearest_enemy = 99, camps_hitting = 0;
+        for (const auto& e : S.enemies) {
+            if (W.enemy_spawn.is_set(e.pos) || !unit_alive(e.ch)) continue;
+            nearest_enemy = std::min(nearest_enemy, dist(at, e.pos));
+            if (dist(at, e.pos) <= S.range) champ_in_range = true;
+            if (dist(at, e.pos) <= 4) champ_in_4 = true;
+        }
+        for (const auto& c : S.camps) {
+            if (!c.awake || !unit_alive(c.camp)) continue;
+            if (dist(at, c.pos) <= S.range) camp_in_range = true;
+            if (dist(at, c.pos) <= c.range) ++camps_hitting;
+        }
+        if (me.can_attack() && champ_in_range) audit_note("miss_attack_champ", activity);
+        else if (me.can_attack() && camp_in_range) audit_note("miss_attack_camp", activity);
+        static int traced_miss = 0;
+        if (me.can_attack() && (champ_in_range || camp_in_range) && traced_miss < 6) {
+            ++traced_miss;
+            std::cout << "MA" << S.round << " s" << W.slot << " " << cambc::to_string(me.champion_name()) << " act=" << activity
+                      << " champ=" << champ_in_range << " camp=" << camp_in_range << " moved=" << moved << " walked=" << S.walked
+                      << " attacked=" << S.attacked << " range=" << S.range << " fuel=" << cambc::fuel_remaining() << " stale=" << stale() << '\n';
+        }
+        if (me.can_cast() && champ_in_4) {
+            for (const auto& ab : me.abilities()) {
+                if (!castable_now(ab)) continue;
+                if (!(ab.is_damage() || ab.is_aoe_damage() || ab.is_cc())) continue;
+                bool target = false;
+                const auto tiles = ab.valid_tiles();
+                for (const auto& e : S.enemies)
+                    if (!W.enemy_spawn.is_set(e.pos) && tiles.is_set(e.pos) && unit_alive(e.ch)) target = true;
+                if (target) audit_note(moved ? "miss_cast_champ_moved" : "miss_cast_champ_still", activity);
+            }
+        }
+        const char* a = activity;
+        const bool wants_move = !std::strcmp(a, "to_capture") || !std::strcmp(a, "approach") || !std::strcmp(a, "bank")
+            || !std::strcmp(a, "home_heal") || !std::strcmp(a, "shop_trip") || !std::strcmp(a, "help") || !std::strcmp(a, "retreat")
+            || !std::strcmp(a, "flee");
+        if (wants_move && !moved && me.can_move()) {
+            // Why: every free neighbour inside enemy danger (moves avoid it on purpose), or none free at all.
+            bool free_tile = false;
+            for (auto d : DIRS) {
+                const vec2 t{at.x + d.x, at.y + d.y};
+                if (!cm::is_in_bounds(t) || W.terrain.is_set(t) || S.occ.is_set(t)) continue;
+                free_tile = true;
+            }
+            bool danger_near = false;
+            for (auto d : DIRS) if (in_danger(vec2{at.x + d.x, at.y + d.y})) danger_near = true;
+            const char* why = !free_tile ? "stuck_boxed" : S.avoid_danger && danger_near ? "stuck_danger" : "stuck_other";
+            if (!std::strcmp(why, "stuck_other") && !std::strcmp(a, "to_capture") && current_target >= 0) {
+                const auto& g = W.groups[current_target];
+                const bool on_tile = g.tiles.is_set(at);
+                bool tile_free = false;
+                for (auto sp : g.spawns) if (!S.occ.is_set(sp)) tile_free = true;
+                why = on_tile ? "stuck_cap_on_tile" : !tile_free ? "stuck_cap_tiles_taken"
+                    : g.state == 0 ? "stuck_cap_state0" : g.state == 1 ? "stuck_cap_state1" : "stuck_cap_state2";
+            }
+            audit_note(why, a);
+            // Trace the first stuck turns of each champion: neighbours as '#' terrain, 'o' occupied, 'd' enemy danger,
+            // 'r' camp reach, else the route's field value (capped at 9), with the field value here. The route is read
+            // as last built (no rebuild here, so the audit does not change play).
+            static int traced = 0;
+            const bool homeward = !std::strcmp(a, "flee") || !std::strcmp(a, "home_heal") || !std::strcmp(a, "retreat");
+            const distance_field* f = homeward || current_target < 0 ? &W.spawn_field : W.groups[current_target].field.get();
+            if (traced < 8 && f && std::strcmp(why, "stuck_danger") != 0) {
+                ++traced;
+                bitboard reach;
+                for (const auto& c : S.camps) if (c.awake) reach.draw_chebyshev(c.pos, static_cast<float>(c.range));
+                for (const auto& c : S.phantoms) reach.draw_chebyshev(c.pos, static_cast<float>(c.range));
+                std::cout << "S" << S.round << " s" << W.slot << " " << why << "." << a << " at=" << cambc::to_string(at)
+                          << " tgt=" << current_target << " st=" << (current_target >= 0 ? W.groups[current_target].state : -1)
+                          << " here=" << f->get(at) << " fuel=" << cambc::fuel_remaining() << " inreach=" << reach.is_set(at)
+                          << " av=" << S.avoid_danger << " nb=";
+                for (auto d : DIRS) {
+                    const vec2 t{at.x + d.x, at.y + d.y};
+                    if (!cm::is_in_bounds(t) || W.terrain.is_set(t)) std::cout << '#';
+                    else if (S.occ.is_set(t)) std::cout << 'o';
+                    else if (in_danger(t)) std::cout << 'd';
+                    else if (reach.is_set(t)) std::cout << 'r';
+                    else std::cout << std::min<int>(9, f->get(t));
+                }
+                int nearest = 99;
+                for (const auto& c : S.camps) if (c.group == current_target) nearest = std::min(nearest, dist(at, c.pos));
+                std::cout << " live_in_view=" << nearest << " range=" << S.range << '\n';
+            }
+        }
+        audit_note("turns", a);
+        // Low health: one line per turn, to read the last turns before a camp death.
+        if (S.hp < S.max_hp * 0.35f)
+            std::cout << "L" << S.round << " s" << W.slot << " hp=" << static_cast<int>(me.health()) << " act=" << a
+                      << " inc=" << static_cast<int>(camp_incoming(at)) << " camps=" << camps_hitting << " en=" << nearest_enemy
+                      << " retr=" << retreating << " moved=" << moved << " gems=" << me.gem_count() << '\n';
+    } catch (const cambc::error& audit_e) {
+        AUDIT(audit_e);
+    }
+}
